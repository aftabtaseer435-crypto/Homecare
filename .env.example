# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never expose

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SocietyHub
CRON_SECRET=change-me-long-random    # Vercel Cron sends this as Bearer token

# --- OPTIONAL: Meta WhatsApp Cloud API for fully automatic sending ---
# Leave empty = manual mode (admin sends from own WhatsApp with one click). No verification needed.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_REMINDER=fund_reminder
WHATSAPP_TEMPLATE_OVERDUE=fund_overdue
WHATSAPP_TEMPLATE_RECEIPT=payment_receipt
WHATSAPP_TEMPLATE_NOTICE=society_notice
